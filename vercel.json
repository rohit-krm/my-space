{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/tool/:slug*", "destination": "/tool" },
    { "source": "/user/new", "destination": "/user/new.html" },
    { "source": "/user", "destination": "/user/index.html" },
    { "source": "/admin", "destination": "/admin/index.html" }
  ]
}
